/**
 * carddb Android 实现：SQLiteOpenHelper，库文件放应用私有 filesDir。
 * 与 index.uts 的 NativeDb 契约对齐；SQL 由调用方（index.uts ensureSchema / uts.ts）传入。
 */
import { NativeDb, ContactRow, DbValue, DB_NAME } from '../common.uts';
import SQLiteOpenHelper from 'android.database.sqlite.SQLiteOpenHelper';
import SQLiteDatabase from 'android.database.sqlite.SQLiteDatabase';
import SQLiteStatement from 'android.database.sqlite.SQLiteStatement';
import Cursor from 'android.database.Cursor';
import { getAppContext } from 'io.dcloud.uts.android';
import File from 'java.io.File';
import Files from 'java.nio.file.Files';
import Paths from 'java.nio.file.Paths';
import StandardCopyOption from 'java.nio.file.StandardCopyOption';

class BusscardHelper extends SQLiteOpenHelper {
  constructor() {
    super(getAppContext(), DB_NAME, null, 1);
  }
  override onCreate(_db: SQLiteDatabase): void {}
  override onUpgrade(_db: SQLiteDatabase, _oldVersion: Int, _newVersion: Int): void {}
}

let helper: BusscardHelper | null = null;

function db(): SQLiteDatabase {
  if (helper == null) helper = new BusscardHelper();
  return (helper as BusscardHelper).getWritableDatabase();
}

function bind(stmt: SQLiteStatement, args: DbValue[]): void {
  for (let i = 0; i < args.length; i++) {
    const p = (i + 1).toInt();
    const v = args[i];
    if (v == null) stmt.bindNull(p);
    else if (typeof v === 'number') stmt.bindDouble(p, v.toDouble());
    else stmt.bindString(p, v);
  }
}

function escapeLit(v: DbValue): string {
  if (v == null) return 'NULL';
  if (typeof v === 'number') return v.toString();
  return `'` + v.split(`'`).join(`''`) + `'`;
}

function inlineArgs(sql: string, args: DbValue[]): string {
  const parts = sql.split('?');
  let out = parts[0];
  for (let i = 1; i < parts.length; i++) {
    out += (i - 1 < args.length ? escapeLit(args[i - 1]) : '?') + parts[i];
  }
  return out;
}

class AndroidDb implements NativeDb {
  open(_name: string): void {
    db();
  }
  exec(sql: string, args: DbValue[]): number {
    const stmt = db().compileStatement(sql);
    try {
      bind(stmt, args);
      try {
        return stmt.executeInsert().toDouble();
      } catch (_e) {
        stmt.execute();
        return 0;
      }
    } finally {
      stmt.close();
    }
  }
  execNoResult(sql: string, args: DbValue[]): number {
    const stmt = db().compileStatement(sql);
    try {
      bind(stmt, args);
      try {
        return stmt.executeUpdateDelete();
      } catch (_e) {
        stmt.execute();
        return 0;
      }
    } finally {
      stmt.close();
    }
  }
  query(sql: string, args: DbValue[]): ContactRow[] {
    // UTSArray 无法直传 Java String[]：无参走 rawQuery(sql, null)；
    // 有参走转义内联（本 App 的查询本就无参，此为完整性兜底，SQL 内不得含字面问号）。
    const cur: Cursor = args.length === 0
      ? db().rawQuery(sql, null)
      : db().rawQuery(inlineArgs(sql, args), null);
    const out: ContactRow[] = [];
    try {
      const n: number = cur.getColumnCount();
      const cols: string[] = [];
      for (let i = 0; i < n; i++) cols.push(cur.getColumnName(i.toInt()));
      while (cur.moveToNext()) {
        const row = new Map<string, DbValue>();
        for (let i = 0; i < n; i++) {
          const p = i.toInt();
          row.set(cols[i], cur.isNull(p) ? null : cur.getString(p));
        }
        out.push(row);
      }
    } finally {
      cur.close();
    }
    return out;
  }
  close(): void {
    helper?.close();
    helper = null;
  }
  reopenDbFile(srcAbsPath: string): void {
    this.close();
    const filesDir = getAppContext()?.getFilesDir();
    if (filesDir == null) throw new Error('no filesDir');
    const dst = new File(filesDir, DB_NAME);
    Files.copy(Paths.get(srcAbsPath), dst.toPath(), StandardCopyOption.REPLACE_EXISTING);
    db();
  }
}

export const nativeDb: NativeDb = new AndroidDb();
